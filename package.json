{
  "name": "dsh-exec-extension",
  "version": "0.1.2",
  "description": "Official-pattern dsh bundle: replace headless-startup with per-invocation CLI flags without writing settings",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LvDAO/dsh-exec-extension.git"
  },
  "bugs": {
    "url": "https://github.com/LvDAO/dsh-exec-extension/issues"
  },
  "homepage": "https://github.com/LvDAO/dsh-exec-extension#readme",
  "type": "module",
  "main": "./js/startup.js",
  "exports": {
    ".": "./js/startup.js",
    "./startup": "./js/startup.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "js/startup.js",
    "js/command.js",
    "js/policy.js",
    "js/task.js",
    "js/output.js",
    "js/generated/native.js",
    "js/generated/native.d.ts",
    "js/generated/native_bg.wasm",
    "js/generated/native_bg.wasm.d.ts",
    "js/generated/package.json",
    "cordis.patch.yml",
    "src",
    "Cargo.toml",
    "Cargo.lock",
    "README.md",
    "README.zh.md",
    "AGENTS.md",
    "LICENSE",
    "scripts/acceptance.sh",
    "scripts/prepare.mjs"
  ],
  "scripts": {
    "build": "cargo build --release --target wasm32-unknown-unknown && wasm-bindgen --target nodejs --out-dir js/generated --out-name native target/wasm32-unknown-unknown/release/dsh_exec_extension.wasm && node -e \"require('fs').writeFileSync('js/generated/package.json', JSON.stringify({type:'commonjs'}))\"",
    "test": "cargo test && node --test js/*.test.js",
    "acceptance": "bash scripts/acceptance.sh",
    "prepare": "node scripts/prepare.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-cmdline": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-headless": "^0.1.0-rc.7",
    "commander": "^15.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-headless": "^0.1.0-rc.7"
  },
  "engines": {
    "node": ">=22.19"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "headless",
    "cordis",
    "dsh-extension"
  ]
}
